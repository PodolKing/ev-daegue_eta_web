# FE map / API client env — never put DB or server-only keys here.

# Backend base URL (no trailing slash)
# PC only: http://localhost:8000
# Same-WiFi mobile: http://<PC-LAN-IP>:8000  (see api/docs/teamdeveloper.md § mobile)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# TMAP map SDK key (browser-exposed). Separate from BE TMAP_APP_KEY (POI/ETA REST).
# Restrict by domain/referrer in TMAP console. Do NOT put server REST key here.
NEXT_PUBLIC_TMAP_MAP_KEY=
