# FE map / API client env — never put DB or server-only keys here.

# Backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# TMAP map SDK key (browser-exposed). Separate from BE TMAP_APP_KEY.
# Confirm in TMAP console whether JS/map key matches REST app key & domain restrict.
NEXT_PUBLIC_TMAP_APP_KEY=
